# Application
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-random-64-char-secret
FRONTEND_URL=https://gdgc.swappy.lol
API_BASE_URL=http://127.0.0.1:8000

# Database (Neon PostgreSQL - use postgresql+psycopg://...)
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/pulse?sslmode=require
DIRECT_DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/pulse?sslmode=require

# Firebase Authentication
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini Enterprise Gateway
GEMINI_GATEWAY_URL=
GEMINI_GATEWAY_KEY=
GEMINI_GATEWAY_MODEL=
GEMINI_GATEWAY_PROTOCOL=
GEMINI_GATEWAY_PATH=

# SMTP Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pulse.example.com
SMTP_USE_TLS=true

# Storage
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Networking
PORT=3000
BACKEND_PORT=8000
